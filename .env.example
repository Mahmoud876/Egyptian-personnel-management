# Copy to .env (scripts/setup.ps1 does this and generates the passwords).
# Never commit .env.

# dev | prod. In prod the OpenAPI docs are disabled.
ENV=dev

# --- SQL Server dev container (docker-compose.dev.yml) ---
# Must meet SQL Server complexity rules. Only applied when the data volume is first created.
MSSQL_SA_PASSWORD=change-me-Aa1
DB_PORT=1433

# --- Database ---
# 127.0.0.1, not localhost: localhost resolves to ::1 first and the container port is bound to IPv4 only.
DB_HOST=127.0.0.1
DB_NAME=personnel
DB_DRIVER=ODBC Driver 18 for SQL Server
# Dev container uses a self-signed certificate. Keep false in production.
DB_TRUST_SERVER_CERTIFICATE=true

# App login: least privilege, created by scripts/db-init.ps1 (backend/sql/007_app_login.sql).
# Cannot UPDATE/DELETE audit_log or change permission codes.
DB_USER=personnel_app
DB_PASSWORD=change-me-Aa1

# Admin login: used only by scripts/db-init.ps1 to create the database, tables and the app login.
DB_ADMIN_USER=sa
DB_ADMIN_PASSWORD=change-me-Aa1

# --- Sessions ---
# Dev runs over plain HTTP; set true in production (HTTPS), otherwise the browser won't send the cookie.
SESSION_COOKIE_SECURE=false
SESSION_IDLE_MINUTES=30
SESSION_MAX_HOURS=12

# --- Ports ---
API_PORT=8000
WEB_PORT=5173

# Redis 7.2 (BSD), RQ workers and private shared files.
REDIS_PORT=6379
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_PREFIX=personnel
QUEUE_NAME=personnel
# Defaults to <repository>/storage. API and workers must share this directory.
# STORAGE_ROOT=D:/personnel-storage
UPLOAD_MAX_BYTES=52428800
IMPORT_MAX_ROWS=100000
IMPORT_DUPLICATE_POLICY=reject_all
JOB_MAX_ATTEMPTS=3
JOB_TIMEOUT_SECONDS=3600
# Recovery is a fallback; accepted requests also attempt delivery immediately after SQL commit.
RECOVERY_INTERVAL_SECONDS=30
IMPORT_WORKERS=1
EXPORT_WORKERS=1
DISPATCH_BATCH_SIZE=100
EXPORT_BATCH_SIZE=500
# Jobs already waiting in RQ need less frequent reconciliation.
QUEUED_RECHECK_SECONDS=300
ACCESS_TABLE=person_data
# Optional empty .accdb template; Windows ACE driver is required for Access I/O.
# ACCESS_TEMPLATE=D:/templates/empty.accdb
