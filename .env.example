# Copy to .env (scripts/setup.ps1 does this and generates the passwords).
# Never commit .env.

# dev | prod. In prod the OpenAPI docs are disabled.
ENV=dev

# --- SQL Server dev container (docker-compose.dev.yml) ---
# Must meet SQL Server complexity rules. Only applied when the data volume is first created.
MSSQL_SA_PASSWORD=change-me-Aa1
DB_PORT=1433

# --- Backend connection ---
# Phase 0 connects as sa to master; Phase 1 switches to the app database and a least-privilege login.
# 127.0.0.1, not localhost: localhost resolves to ::1 first and the container port is bound to IPv4 only.
DB_HOST=127.0.0.1
DB_NAME=master
DB_USER=sa
DB_PASSWORD=change-me-Aa1
DB_DRIVER=ODBC Driver 18 for SQL Server
# Dev container uses a self-signed certificate. Keep false in production.
DB_TRUST_SERVER_CERTIFICATE=true

# --- Ports ---
API_PORT=8000
WEB_PORT=5173
